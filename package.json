{
  "name": "reform",
  "version": "1.0.0",
  "description": "フォームの入力欄IDを調べるツール",
  "scripts": {
    "start": "npm run build && npm-run-all -p watch:* serve",
    "serve": "wrangler pages dev build",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "watch:sass": "npm run build:sass -- --watch",
    "watch:html": "npm run build:copy:html -- --watch",
    "watch:js": "npm run build:copy:js -- --watch",
    "build": "npm-run-all clean build:** -s",
    "build:sass": "sass ./src/index.sass ./build/index.css --style=compressed",
    "build:copy:html": "cpx \"src/**/*.html\" build/",
    "build:copy:assets": "cpx \"src/assets/**/*\" build/assets/",
    "build:copy:js": "cpx \"src/js/**/*\" build/js/",
    "test": "node --test"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CALIL/reform.git"
  },
  "license": "MIT",
  "devDependencies": {
    "cpx2": "^9.0.0",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.103.1",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0"
    }
  }
}
